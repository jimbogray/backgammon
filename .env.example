# Copy to .env (or set these in your host's dashboard). All are optional in development.

# Port the server listens on.
PORT=3000

# Public address of the site. Required in production when Google sign-in is on;
# the Google redirect URI is APP_URL + /auth/google/callback.
APP_URL=http://localhost:5173

# Where the SQLite database file lives. Put it on a persistent disk in production.
DATABASE_PATH=./data/backgammon.db

# SQLite journal mode: wal (default) or delete. Use delete when the database sits
# on a network file share, such as /home on Azure App Service.
DATABASE_JOURNAL_MODE=wal

# Google sign-in. Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
