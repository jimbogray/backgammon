# Copy to .env for the API server (or set these in your host). All are optional in development.

# Port the API listens on.
PORT=3000

# Public address of the web app. Google sign-in returns here, and it is the
# origin allowed to call the API (CORS).
APP_URL=http://localhost:5173

# Public address of the API. The Google redirect URI is API_URL + /api/auth/google/callback.
# In development the web app proxies /api, so this defaults to APP_URL.
# API_URL=http://localhost:5173

# Extra origins allowed to call the API, comma-separated. Defaults to APP_URL.
# CORS_ORIGINS=

# Postgres. `npm run db:up` starts one matching this default in Docker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backgammon

# "password" (default) or "entra" to sign in to Azure Database for PostgreSQL
# with a managed identity (or your `az login` locally) instead of a password.
DATABASE_AUTH=password

# Google sign-in. Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
